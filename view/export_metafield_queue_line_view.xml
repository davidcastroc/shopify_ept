<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--Tree view of export metafields queue line which is use in queue line dashboard-->
    <!-- <header>
                    <button
                            name="%(shopify_ept.action_sync_export_metafields_queue)d"
                            string="Process Queue Line" type="action"/>
                </header>                -->
<!--                <field name="__last_update"/>-->
    <record id="view_export_metafields_queue_line_tree" model="ir.ui.view">
        <field name="name">export.metafields.queue.line.tree</field>
        <field name="model">shopify.export.metafields.queue.line.ept</field>
        <field eval="100" name="priority"/>
        <field name="arch" type="xml">
            <list create="0" duplicate="0" edit="0" decoration-danger="state=='failed'"
                  decoration-success="state=='done'" decoration-info="state=='draft'">
                <header>
                    <button
                            name="%(shopify_ept.action_sync_export_metafields_queue)d"
                            string="Process Queue Line" type="action"/>
                </header>
                <field name="shopify_instance_id"/>
                <field name="resource_type"/>
                <field name="write_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!--Form view of export metafields queue line-->
    <record id="view_shopify_export_metafields_queue_line_ept_form"
            model="ir.ui.view">
        <field name="name">shopify.export.metafields.queue.line.ept.form</field>
        <field name="model">shopify.export.metafields.queue.line.ept</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="shopify_instance_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="export_metafields_queue_id" readonly="1"/>
                            <field name="write_date" string="Last Updated On"
                                   readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Log Lines">
                            <field name="common_log_lines_ids">
                                <list create="false">
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                        <page string="Metafields Data">
                            <group>
                                <field string="Metafields Data" name="metafield_payload" widget="text"
                                       readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
