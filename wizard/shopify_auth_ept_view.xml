<odoo>
    <record id="view_shopify_auth_process_ept_form" model="ir.ui.view">
        <field name="name">shopify.auth.process.ept.form</field>
        <field name="model">shopify.auth.process.ept</field>
        <field name="arch" type="xml">
            <form string="Set Shopify Authorization Details">
                <sheet>
                    <field name="state" invisible="1"/>
                    <div invisible="state != 'draft'">
                        <div class="oe_title mb-3">
                            <h2>Connect Shopify Store</h2>
                            <p class="text-muted">
                                Enter your Shopify app credentials to begin the OAuth flow.
                            </p>
                        </div>
                        <group string="Store Credentials">
                            <field name="shopify_host"
                                   placeholder="e.g. demo.myshopify.com"/>
                            <field name="shopify_client_id"
                                   placeholder="API Key from your Shopify custom app"/>
                            <field name="shopify_secret_id"
                                   placeholder="API Secret Key"/>
                        </group>
                        <group string="App Integration URLs">
                            <field name="redirect_url" readonly="1" widget="CopyClipboardChar"/>
                            <field name="app_url" readonly="1" widget="CopyClipboardChar"/>
                        </group>
                    </div>
                    <div invisible="state != 'token_generated'">
                        <div class="oe_title mb-3">
                            <h2>Shopify Access Token</h2>
                        </div>
                        <div class="alert alert-info d-flex align-items-center justify-content-between mb-3"
                             role="alert">
                            <span>
                                <i class="fa fa-info-circle me-1" title="Info"/>
                                <strong>Not what you expected?</strong>
                                Click <strong>Reset &amp; Start Over</strong> if:
                                <ul class="mb-0 mt-1">
                                    <li>The token page opened directly without going through the authorization
                                        process.
                                    </li>
                                    <li>The store domain shown here is different from the one you entered during this
                                        process.
                                    </li>
                                </ul>
                            </span>
                            <button name="action_reset_auth"
                                    type="object"
                                    string="Reset &amp; Start Over"
                                    class="btn btn-sm btn-warning ms-3"
                                    confirm="This will clear the current token data. You will need to re-authorize with Shopify. Continue?"/>
                        </div>
                        <div class="alert alert-success mb-3" role="alert">
                            <i class="fa fa-check-circle me-1" title="Success"/>
                            <field name="token_status" readonly="1" nolabel="1" force_save="1"/>
                        </div>
                        <group string="Token Details">
                            <field name="shopify_host" readonly="1" force_save="1"/>
                            <field name="access_token" readonly="1" force_save="1"
                                   widget="CopyClipboardChar"/>
                        </group>

                        <div class="alert alert-warning mt-3" role="alert">
                            <i class="fa fa-exclamation-triangle me-1" title="Warning"/>
                            <strong>Save this token now.</strong>
                            It will not be shown again once you close this window.
                        </div>

                    </div>

                </sheet>

                <footer>
                    <button name="generate_auth_link"
                            type="object"
                            string="Authorize with Shopify"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_create_instance"
                            type="object"
                            string="Create Shopify Instance →"
                            class="btn-primary"
                            invisible="state != 'token_generated'"/>
                    <button string="Close"
                            class="btn-secondary"
                            name="action_close"
                            type="object"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shopify_auth_process_ept" model="ir.actions.act_window">
        <field name="name">Connect Shopify</field>
        <field name="res_model">shopify.auth.process.ept</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>